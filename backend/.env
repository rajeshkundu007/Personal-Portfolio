# ============================================================
# backend/.env — Environment Variables (SECRETS — never commit this to Git!)
# ============================================================
# This file stores sensitive credentials so they are NOT
# hardcoded in your source code.
#
# HOW TO SET UP GMAIL APP PASSWORD:
#  1. Go to your Google Account → Security
#  2. Turn ON "2-Step Verification" (required for App Passwords)
#  3. Go to Security → "App Passwords"
#  4. Choose App: "Mail" | Device: "Other" → type "Portfolio"
#  5. Google will show you a 16-character password
#  6. Paste that password as GMAIL_PASS below (no spaces)
#
# Example GMAIL_PASS: abcd efgh ijkl mnop → use: abcdefghijklmnop
# ============================================================

# Your Gmail address (the one sending the notification)
GMAIL_USER=kundurj4359@gmail.com

# The 16-character App Password generated from Google Account settings
# ⚠️  Replace "your_app_password_here" with your actual App Password
GMAIL_PASS=rhgcozflhexzeeyt

# The email address that receives notifications (your inbox)
NOTIFY_EMAIL=kundurj4359@gmail.com

# Server port (optional, defaults to 3000)
PORT=3000
